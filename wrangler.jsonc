{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three-line-diary",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "diary", "database_id": "replace-after-creating-d1", "migrations_dir": "migrations" }]
}
