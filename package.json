{
  "name": "three-line-diary",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DIARY_LOCAL_BUILD=1 wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply diary --local",
    "db:remote": "wrangler d1 migrations apply diary --remote",
    "test": "node --test",
    "holidays:update": "node scripts/update-holidays.js",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
